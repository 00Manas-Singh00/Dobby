# deploy/Dockerfile.server
# The API and Socket.IO server. Terminal support is deliberately absent: it
# needs a Docker socket, and handing a container the host's daemon undoes the
# sandboxing ADR-011 exists for. Run terminal-enabled instances separately.

FROM node:22-bookworm-slim

# better-sqlite3 has no prebuilt binary for every platform and is built from
# source when none matches.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copied before the source so a code change does not reinstall dependencies.
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY server/ ./

# node-pty is optional here — the image builds without a terminal — but its
# absence must not be a startup failure, so ENABLE_TERMINAL defaults to false.
ENV NODE_ENV=production ENABLE_TERMINAL=false

EXPOSE 5001

# No init system and no shell wrapper: node is PID 1 so SIGTERM reaches it
# directly, which is what lets it hand back its document leases on shutdown
# instead of leaving them to expire.
CMD ["node", "index.js"]
