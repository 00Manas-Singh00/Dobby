PORT=5001

# ─── Authentication (required) ────────────────────────────────────────────────
# Signing key for access tokens. The server refuses to start without one of at
# least 32 characters — a shared default would mean forgeable sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access tokens are short-lived and refreshed silently by the client; refresh
# tokens are stored hashed and revoked on use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=2592000000
BCRYPT_ROUNDS=12

# ─── Clustering ───────────────────────────────────────────────────────────────
# The single variable that decides whether Dobby runs as one process or several.
#
# Unset (the default): single node. Room membership, document state, and the
# REST quotas all live in this process, which is correct and cheap for one
# replica.
#
# Set: this process joins a cluster. Socket.IO rooms span replicas through the
# Redis adapter, the REST rate limits share one set of counters, Yjs documents
# are stored in Redis rather than LevelDB, and each document is served by
# whichever replica holds its lease.
#
# It fails CLOSED. If this is set and Redis is unreachable, the server refuses
# to start rather than quietly running as an isolated replica — that failure
# would present as "my partner's edits sometimes don't arrive", which is far
# worse to diagnose than not starting.
#
# Redis holds document content in cluster mode, so it is a database here, not a
# cache: run it with persistence on and `maxmemory-policy noeviction`.
# REDIS_URL=redis://localhost:6379

# Prefix for every Redis key this deployment writes, so one Redis can be shared
# between environments.
REDIS_KEY_PREFIX=dobby

# This process's identity in the cluster: a pod name, a task id, anything
# stable for the life of the process. Defaults to a random id per start, which
# is the right default — a restarted process must not inherit the document
# leases of the one it replaced.
# NODE_ID=

# How long a document lease survives without a heartbeat. The node renews every
# third of this, so two renewals can be missed before another node may take the
# document. Lower means a crashed node's documents recover sooner; higher means
# more tolerance for a slow Redis.
DOCUMENT_LEASE_TTL_MS=30000

# Yjs updates are appended to a list per document and merged into one entry once
# the list passes this length. Safe to do without a lock because the lease makes
# the owning node the only writer.
YJS_REDIS_COMPACT_AFTER=200

# ─── Observability ────────────────────────────────────────────────────────────
# /metrics exposes Prometheus counters and gauges: active rooms, connected
# sockets, live PTYs, Yjs document sizes, execution latency, socket events by
# outcome. It is an inventory of the instance, so unlike /health it is guarded.
#
# With a token set, any caller presenting it as a bearer token may scrape.
# With it unset, only loopback callers may — a sidecar, or an SSH tunnel. The
# default is therefore closed to the network rather than open.
# METRICS_TOKEN=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Postgres connection string for accounts, rooms, memberships, invites, the file
# tree, chat, and document history.
#
# Unset, the server uses the SQLite file below and is byte-for-byte the
# single-host server it has always been. Set, it uses Postgres instead and
# DATABASE_PATH is ignored. This is the switch that lets replicas run on
# different hosts: SQLite is single-writer, so replicas sharing one file must
# share a machine (docs/07-adrs.md#adr-017).
#
# Startup fails if it is unreachable, for the same reason an unreachable Redis
# does: a replica with no store answers every request with a 500, and an
# orchestrator restarting it is a better outcome than one that looks healthy.
# DATABASE_URL=postgres://dobby:dobby@localhost:5432/dobby

# Set to true when the Postgres server presents a certificate this host does not
# have a CA for — a managed provider's default. Off means a plain connection.
# DATABASE_SSL=false

# Connections this process keeps open to Postgres. The ceiling that matters is
# the server's `max_connections` divided by the number of replicas.
# PG_POOL_MAX=10

# SQLite file holding accounts, rooms, memberships, and invites. Ignored when
# DATABASE_URL is set.
DATABASE_PATH=./.data/dobby.db

# LevelDB directory holding Yjs document state. Single-node only: LevelDB takes
# an exclusive lock on its directory, so two replicas cannot share one, and
# pointing them at the same volume fails rather than working badly. Ignored when
# REDIS_URL is set — documents live in Redis then, and a LevelDB directory would
# be a second, per-node copy of the truth. Set to an empty string to run the
# CRDT entirely in memory (what the tests do).
YJS_PERSISTENCE_DIR=./.yjs-persistence

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of exact browser origins allowed to call the API and
# open Socket.IO connections. Wildcards are not supported by design.
ALLOWED_ORIGINS=http://localhost:5173

# Number of proxy hops to trust for the client IP. Leave unset when the app is
# directly exposed; set to 1 behind a single load balancer. Rate limits key on
# the client IP for anonymous callers, so an unset value behind a proxy would
# put every user in one bucket.
# TRUST_PROXY=1

# ─── Rate limits ──────────────────────────────────────────────────────────────
EXECUTE_RATE_LIMIT=20        # code executions per minute, per user
AUTH_RATE_LIMIT=10           # login/register/refresh attempts per 15 minutes
API_RATE_LIMIT=300           # all other API calls per minute

# ─── Payload caps ─────────────────────────────────────────────────────────────
SOCKET_MAX_PAYLOAD_BYTES=1000000
MAX_CHAT_MESSAGE_CHARS=4000
MAX_SIGNAL_PAYLOAD_BYTES=128000
MAX_TERMINAL_INPUT_BYTES=8000

# ─── Terminal ─────────────────────────────────────────────────────────────────
# The terminal gives a room's members a real shell. It is off by default.
ENABLE_TERMINAL=false

# 'docker' (default) runs each session in a throwaway container with the limits
# below. 'host' runs an UNSANDBOXED shell on the server host — local development
# only, on a machine you own. With 'docker' selected and no daemon reachable,
# terminal creation fails rather than silently falling back to a host shell.
TERMINAL_ISOLATION=docker
TERMINAL_IMAGE=alpine:3.20
TERMINAL_CPU_LIMIT=0.5
TERMINAL_MEMORY_LIMIT=256m
TERMINAL_PIDS_LIMIT=128
TERMINAL_NETWORK=none
# Writable-layer cap. Only enforced on overlay2 with pquota; leave empty
# elsewhere or `docker run` rejects it.
TERMINAL_STORAGE_LIMIT=

# Root for per-session working directories, bind-mounted into the container at
# /workspace. Defaults to <os tmpdir>/dobby-workspaces. Never a home directory.
TERMINAL_WORKSPACE_ROOT=

# ─── Files & document history ─────────────────────────────────────────────────
# The file tree is metadata only — a file's content is a Yjs document, so these
# bound the shape of a room's workspace rather than its size on disk.
MAX_FILES_PER_ROOM=200
MAX_TREE_DEPTH=12

# Snapshots are point-in-time copies of a document's state, taken on a timer and
# kept in SQLite so a file has a history to restore from. A pass skips any
# document that has not changed since its last snapshot, so an idle room costs
# nothing.
SNAPSHOT_INTERVAL_MS=300000          # capture every 5 minutes
SNAPSHOTS_PER_DOCUMENT=20            # older ones are dropped as new ones arrive
MAX_SNAPSHOT_BYTES=1000000           # history is not a backup; skip huge documents

# ─── Lifecycle & retention ────────────────────────────────────────────────────
TERMINAL_INACTIVITY_TTL_MS=900000    # kill an idle terminal after 15 minutes
ROOM_STATE_TTL_MS=1800000            # drop a room's language state 30 min after it empties
CHAT_HISTORY_LIMIT=100                # retained per room, now in SQLite
INVITE_TTL_MS=86400000               # invites expire after 24 hours

# A room untouched for this long is deleted, along with its Yjs documents.
ROOM_RETENTION_MS=7776000000         # 90 days
RETENTION_SWEEP_INTERVAL_MS=3600000  # sweep hourly
