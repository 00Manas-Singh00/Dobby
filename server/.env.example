PORT=5001

# Comma-separated list of exact browser origins allowed to call the API and
# open Socket.IO connections. Wildcards are not supported by design.
ALLOWED_ORIGINS=http://localhost:5173

# The terminal spawns a real shell on the host for anyone in a room. It is off
# by default. Only enable it where that is acceptable (local dev, or a
# disposable/containerised host) — Dobby has no authentication yet.
ENABLE_TERMINAL=false

# Root directory for per-room terminal working directories.
# Defaults to <os tmpdir>/dobby-workspaces. Never point this at a home directory.
TERMINAL_WORKSPACE_ROOT=

# Lifecycle tuning
TERMINAL_INACTIVITY_TTL_MS=900000
ROOM_STATE_TTL_MS=1800000
CHAT_HISTORY_LIMIT=100
